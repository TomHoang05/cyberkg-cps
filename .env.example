# ── Neo4j (required) ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# ── LLM API Keys (optional) ───────────────────────────────────────────────────
# Only needed if you want to auto-generate narrative dossiers via LLM.
# The dossier download works without these keys (uses KG-structured output).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PRIMARY=openai
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_ANTHROPIC=claude-sonnet-4-6
