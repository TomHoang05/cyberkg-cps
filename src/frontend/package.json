{
  "name": "cyberkg-cps-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "postinstall": "node scripts/fix-asynckit.cjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "d3": "^7.9.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterFramework": ["@testing-library/jest-dom"],
    "transform": {
      "^.+\\.(jsx?|tsx?)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^d3$": "<rootDir>/__mocks__/d3.js",
      "\\.(css|less|scss|sass)$": "<rootDir>/__mocks__/styleMock.js",
      "^asynckit/parallel$": "<rootDir>/__mocks__/asynckitParallel.js"
    },
    "testMatch": ["<rootDir>/tests/**/*.test.{js,jsx}"],
    "collectCoverageFrom": ["src/components/viz/**/*.{js,jsx}"],
    "coverageThreshold": {
      "global": { "lines": 70, "branches": 60 }
    }
  }
}
